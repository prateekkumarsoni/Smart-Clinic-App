# Copy this file to .streamlit/secrets.toml (local) or paste its contents into
# Streamlit Community Cloud > App settings > Secrets. Never commit the real file.

# Encryption key for health records. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY = ""

# Show the demo-account table on the sign-in page (set to "false" after your demo)
SHOW_DEMO_ACCOUNTS = "true"

# Email via Gmail (needs 2-step verification and an App Password)
GMAIL_USER = ""
GMAIL_APP_PASSWORD = ""

# Push via ntfy.sh (pick a long, hard-to-guess topic name and subscribe to it in the ntfy phone app)
NTFY_TOPIC = ""

# SMS via Twilio (trial accounts can only message verified numbers)
TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN = ""
TWILIO_FROM_NUMBER = ""

# Razorpay TEST mode keys (Dashboard > Account & Settings > API Keys, with Test Mode on)
RAZORPAY_KEY_ID = ""
RAZORPAY_KEY_SECRET = ""
